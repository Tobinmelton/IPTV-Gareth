# G-IPTV server configuration
# Copy to .env and adjust, or set these as environment variables.

# Port to listen on (LAN devices reach the UI at http://<server-ip>:<port>)
GIPTV_PORT=8484

# Upstream playlist
GIPTV_PLAYLIST_URL=https://iptv-org.github.io/iptv/index.m3u

# XMLTV guide source (optional but recommended — enables real program
# names in the guide instead of "LIVE"). Any XMLTV URL or local path.
# Examples:
#   GIPTV_EPG_URL=https://www.open-epg.com/files/unitedstates1.xml
#   GIPTV_EPG_URL=/path/to/guide.xml
GIPTV_EPG_URL=
